{
  "@@locale": "en",
  "appName": "FinHub",
  "@appName": {
    "description": "App name displayed in OS dialogs and the app shell."
  },
  "errorNetwork": "No internet connection. Please check your network and try again.",
  "@errorNetwork": {
    "description": "Shown when a NetworkError is thrown (no connectivity)."
  },
  "errorServer": "Server error ({statusCode}). Please try again later.",
  "@errorServer": {
    "description": "Shown when a ServerError (HTTP 5xx) is thrown. statusCode is passed as a string and may be empty when unknown.",
    "placeholders": {
      "statusCode": {
        "type": "String",
        "example": "503"
      }
    }
  },
  "errorUnauthorized": "Your session has expired. Please log in again.",
  "@errorUnauthorized": {
    "description": "Shown when an UnauthorizedError (HTTP 401) is thrown."
  },
  "errorForbidden": "You do not have permission to perform this action.",
  "@errorForbidden": {
    "description": "Shown when a ForbiddenError (HTTP 403) is thrown."
  },
  "errorNotFound": "The requested resource was not found.",
  "@errorNotFound": {
    "description": "Shown when a NotFoundError (HTTP 404) is thrown."
  },
  "errorUnknown": "An unexpected error occurred. Please try again.",
  "@errorUnknown": {
    "description": "Shown when an UnknownError is thrown with no server-provided message."
  },
  "commonInvalidEmail": "Enter a valid email address.",
  "@commonInvalidEmail": {
    "description": "Inline error under an email field whose value isn't a valid address."
  },
  "commonInvalidMobileNumber": "Must be between {min} and {max} digits.",
  "@commonInvalidMobileNumber": {
    "description": "Inline error under a mobile number field whose value isn't between the minimum and maximum digit count.",
    "placeholders": {
      "min": {
        "type": "int"
      },
      "max": {
        "type": "int"
      }
    }
  },
  "commonInvalidPostalCode": "Enter a valid postal code.",
  "@commonInvalidPostalCode": {
    "description": "Inline error under a postal code field whose value isn't a plausible postal code."
  },
  "commonMaxLengthExceeded": "Maximum {max} characters allowed.",
  "@commonMaxLengthExceeded": {
    "description": "Inline error under a text field that has run past its character limit.",
    "placeholders": {
      "max": {
        "type": "int"
      }
    }
  },
  "validationFieldRequired": "{fieldName} is required !",
  "@validationFieldRequired": {
    "description": "Generic required-field validation message. fieldName is the translated label of the field.",
    "placeholders": {
      "fieldName": {
        "type": "String",
        "example": "Full Name"
      }
    }
  }
}
